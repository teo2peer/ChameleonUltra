# build_ipa.sh configuration.
#
# Copy this file to `.env` (same folder as build_ipa.sh) and fill it in:
#     cp .env.example .env
#
# `.env` is gitignored — never commit your real password or certificate.
# Values already set in the shell environment override anything here, e.g.
#     P12_PASSWORD='other' ./build_ipa.sh

# Password for Development.p12 (required for signing).
P12_PASSWORD=

# --- optional overrides (defaults shown) -------------------------------------
# PROFILE=/path/to/Development.mobileprovision
# P12=/path/to/Development.p12

# Target device UDID for auto-install (default: first connected device).
# DEVICE_ID=00000000-0000-0000-0000-000000000000

# Where to drop the built .ipa (default: this repo's root).
# DEST=/path/to/output

# Flutter GUI project location (default: sibling repo).
# GUI_DIR=/path/to/ChameleonUltraGUI/chameleonultragui
